<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy this file to MovieCollection/Resources/Secrets.plist (that copy is
  git-ignored and bundled with the app automatically), then paste in your
  TMDB "API Read Access Token" from https://www.themoviedb.org/settings/api.
  The short "API Key" works too: put it in TMDBAPIKey instead.
  Without Secrets.plist, the app uses only the bundled 200-movie catalog.
-->
<plist version="1.0">
<dict>
	<key>TMDBReadAccessToken</key>
	<string></string>
	<key>TMDBAPIKey</key>
	<string></string>
</dict>
</plist>
